<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="src/index.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Static files (uploads) — ให้ IIS serve โดยตรง ไม่ผ่าน Node.js -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="nodejs">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="src/index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- อนุญาต upload ขนาดใหญ่ (50MB) สำหรับ base64 image -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Cache สำหรับรูปภาพ uploads (1 วัน) -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

    <!-- iisnode settings -->
    <iisnode node_env="production"
             maxRequestBufferSize="52428800"
             watchedFiles="web.config;src\index.js" />
  </system.webServer>
</configuration>
